# Public URL of this app, used in invite and reset links.
APP_URL=https://kickbuy-nu.vercel.app

# KickBuy's own Supabase project (auth + kickbuy schema).
NEXT_PUBLIC_SUPABASE_URL=https://ovbqruuzquxidgnbbnxo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# KickBuy database, as kickbuy_app (transaction pooler, port 6543).
KICKBUY_DB_HOST=aws-0-eu-west-2.pooler.supabase.com
KICKBUY_DB_USER=kickbuy_app.ovbqruuzquxidgnbbnxo
KICKBUY_DB_PASSWORD=

# Kickio database, as the read-only kickbuy_reader (transaction pooler).
# Kickio is on the aws-1 pooler cluster.
KICKIO_DB_HOST=aws-1-eu-west-2.pooler.supabase.com
KICKIO_DB_USER=kickbuy_reader.rlveellvebfzgyobceru
KICKIO_DB_PASSWORD=

# Where KickBuy links to listings and the review queue.
KICKIO_SITE_URL=https://kickio.com

# Vercel Cron sends this as a bearer token to /api/cron/scan. Any long random string.
CRON_SECRET=

# Optional: Telegram alerts. Bot token from @BotFather; leave unset to turn
# the feature off. After setting it and redeploying, an owner presses
# "Connect bot" in Settings → Telegram alerts.
TELEGRAM_BOT_TOKEN=
